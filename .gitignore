# Build outputs
_build/
dist/

# Quarto / jupytext intermediates
.quarto/
.jupyterlite.doit.db*
**/*.quarto_ipynb*

# Quarto support files leaked next to sources (e.g. *_files/, *_freeze/)
**/*_files/
**/_freeze/

# Notebooks are generated from content/exercises/*.py via jupytext
**/*.ipynb
content/notebooks/

# JupyterLite: content is copied from content/ and data/ at build time
jupyterlite/content*/
jupyterlite/dist/

# Python
__pycache__/
*.py[codz]
*.so
.Python
*.egg-info/
.venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# pixi
.pixi/
!.pixi/config.toml

# Local debugging symlink to a skrub development environment
skrub-dev

# OS / editors
.DS_Store
.vscode/
.idea/
/.quarto/
**/*.quarto_ipynb
